# Load order matters: each module reads the ones above it out of the Loadout namespace at load time.
# LoadoutCompat is the only file allowed to branch on the game flavour; LoadoutCore and LoadoutRules
# are pure and are covered by Tests/ under plain Lua.
LoadoutCompat.lua
LoadoutCore.lua
LoadoutRules.lua
LoadoutDB.lua
LoadoutInventory.lua
LoadoutEquip.lua
LoadoutSets.lua
LoadoutEvents.lua
LoadoutUI.lua
LoadoutMinimap.lua

# The bootstrap binds the modules together, so it loads last.
Loadout.lua
